set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES MGS_WINDOWS_SDK)
if(NOT MGS_WINDOWS_SDK)
    message(FATAL_ERROR "Set MGS_WINDOWS_SDK to the prepared llvm-mingw directory")
endif()
file(GLOB _mgs_compilers "${MGS_WINDOWS_SDK}/toolchain/*/bin/x86_64-w64-mingw32-clang")
list(LENGTH _mgs_compilers _mgs_count)
if(NOT _mgs_count EQUAL 1)
    message(FATAL_ERROR "Expected one pinned LLVM-MinGW compiler")
endif()
list(GET _mgs_compilers 0 CMAKE_C_COMPILER)
get_filename_component(_mgs_bin "${CMAKE_C_COMPILER}" DIRECTORY)
get_filename_component(_mgs_llvm "${_mgs_bin}" DIRECTORY)
set(CMAKE_CXX_COMPILER "${_mgs_bin}/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "${_mgs_bin}/x86_64-w64-mingw32-windres")
set(CMAKE_FIND_ROOT_PATH "${MGS_WINDOWS_SDK}/target" "${_mgs_llvm}/x86_64-w64-mingw32")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_CXX_STANDARD_LIBRARIES "-static-libstdc++ -static-libgcc" CACHE STRING "" FORCE)
# Test discovery is performed by the Windows/Wine runner after linking.
set(CMAKE_GTEST_DISCOVER_TESTS_DISCOVERY_MODE PRE_TEST)
