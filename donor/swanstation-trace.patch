+static void TraceDonorPC()
+{
+  static FILE* trace = []() -> FILE* {
+    const char* path = std::getenv("PS1_DONOR_PC_TRACE");
+    return (path && *path) ? std::fopen(path, "w") : nullptr;
+  }();
+  if (!trace)
+    return;
+
+  struct Targets
+  {
+    std::array<uint32_t, 64> values{};
+    size_t count = 0;
+  };
+  static const Targets targets = []() {
+    Targets parsed;
+    const char* cursor = std::getenv("PS1_DONOR_PC_TARGETS");
+    while (cursor && *cursor && parsed.count < parsed.values.size())
+    {
+      while (*cursor == ',' || *cursor == ';' || *cursor == ' ' || *cursor == '\t')
+        cursor++;
+      if (!*cursor)
+        break;
+      char* end = nullptr;
+      const unsigned long value = std::strtoul(cursor, &end, 0);
+      if (end == cursor)
+        break;
+      parsed.values[parsed.count++] = static_cast<uint32_t>(value);
+      cursor = end;
+    }
+    return parsed;
+  }();
+  if (targets.count == 0)
+    return;
+
+  static const unsigned long frame_from = []() {
+    const char* text = std::getenv("PS1_DONOR_PC_FRAME_FROM");
+    return text ? std::strtoul(text, nullptr, 0) : 0ul;
+  }();
+  static const unsigned long frame_to = []() {
+    const char* text = std::getenv("PS1_DONOR_PC_FRAME_TO");
+    return text ? std::strtoul(text, nullptr, 0) : ~0ul;
+  }();
+  const uint32_t frame = System::GetFrameNumber();
+  if (frame < frame_from || frame > frame_to)
+    return;
+
+  bool matched = false;
+  for (size_t index = 0; index < targets.count; index++)
+    matched |= targets.values[index] == g_state.current_instruction_pc;
+  if (!matched)
+    return;
+
+  static unsigned long long sequence = 0;
+  const auto& r = g_state.regs.r;
+  donor_snapshot::capture(frame,g_state.current_instruction_pc,r,Bus::g_ram,Bus::g_ram_size,
+                          g_state.dcache.data(),g_state.dcache.size());
+  std::fprintf(trace,
+               "{\"schema\":\"ps1trace/v1\","
+               "\"source\":\"swanstation\",\"seq\":%llu,"
+               "\"frame\":%u,\"host_us\":0,"
+               "\"event\":\"mips.pc\",\"pc\":%u,"
+               "\"v0\":%u,\"v1\":%u,"
+               "\"a0\":%u,\"a1\":%u,\"a2\":%u,\"a3\":%u,"
+               "\"t0\":%u,\"t1\":%u,\"t2\":%u,\"t3\":%u,"
+               "\"t4\":%u,\"t5\":%u,\"t6\":%u,\"t7\":%u,"
+               "\"s0\":%u,\"s1\":%u,\"s2\":%u,\"s3\":%u,"
+               "\"s4\":%u,\"s5\":%u,\"s6\":%u,\"s7\":%u,"
+               "\"t8\":%u,\"t9\":%u,\"gp\":%u,\"sp\":%u,"
+               "\"s8\":%u,\"ra\":%u}\n",
+               ++sequence, frame, g_state.current_instruction_pc, r[2], r[3], r[4], r[5], r[6], r[7], r[8],
+               r[9], r[10], r[11], r[12], r[13], r[14], r[15], r[16], r[17], r[18], r[19], r[20], r[21],
+               r[22], r[23], r[24], r[25], r[28], r[29], r[30], r[31]);
+}
+
