    "command": "env PS1_RUN_VULKAN_INTEGRATION=1 PS1_VULKAN_HIDDEN_WINDOW=1 PS1_TEST_MGS_ASSET_CACHE=data/presentation/usa-source/assets.mgsc PS1_TEST_MGS_USA_EXE=data/assets/usa/disc1/SLUS_005.94 PS1_TEST_MGS_EFFECT_RAM=data/scenarios/situations/quick-items-matrix-01/s15a-quick-item/native/session/final-ram.bin PS1_TEST_MGS_FOG_RAM=data/scenarios/usa-normal/cases/d1-13-s12b-204/native-01/session/final-ram.bin build/ps1Test/ps1Runtime_tests --gtest_filter='Mgs*:*Vulkan*:*ModernReplay*'",
    "specific_assertions": [
      "All 77 complete scripts identify; changed byte or atlas rejects; snapshots do not mutate RAM.",
      "Malformed/cyclic actor lists, stale allocations and wrong opcode/page/CLUT reject.",
      "Dynamic DG_MDL laser uses original indexed positions/normals and requires its living owner.",
      "Mirror+Camo compose across both actor-list orderings; plane clipping is retained for reflected surfaces.",
      "USA mosaic, radar jamming, HIDEO, SGT and dynamic SnowStorm have ownership/activation tests.",
      "Panorama explicitly owns affine projection; subpixel XY does not invent GTE depth.",
      "Photo GPU export captures frame 2 even if the producer has advanced to a different frame 3 and empty frame 4; no duplicate export.",
      "GPU light evaluation is per pixel; RGB8 gradients exceed 32 levels; effect blending accumulates and native VRAM is unchanged.",
      "3840x2160 raster retains subpixels and fixed16:9 viewport across window resizing."
    ]
  },
