diff --git a/src/gte/PsyX_GTE.cpp b/src/gte/PsyX_GTE.cpp
index 72e91cf..99999a1 100644
--- a/src/gte/PsyX_GTE.cpp
+++ b/src/gte/PsyX_GTE.cpp
@@ -1,4 +1,5 @@
 #include "PsyX_GTE.h"
+#include "../PsyX_trace.h"
 #include "PsyX/PsyX_globals.h"
 #include "PsyX/PsyX_public.h"
 
@@ -23,5 +24,61 @@ GTERegisters gteRegs;
 #define gteop(code)			(code & 0x1ffffff)
 
+namespace {
+
+uint32_t hashGteRegisters()
+{
+	uint32_t hash = 2166136261u;
+	for (int bank = 0; bank < 2; ++bank)
+	{
+		const unsigned int* registers = bank == 0 ? gteRegs.CP2D.r : gteRegs.CP2C.r;
+		for (int i = 0; i < 32; ++i)
+		{
+			const uint32_t value = registers[i];
+			for (unsigned shift = 0; shift < 32; shift += 8)
+			{
+				hash ^= (value >> shift) & 0xffu;
+				hash *= 16777619u;
+			}
+		}
+	}
+	return hash;
+}
+
+class GteTraceScope
+{
+public:
+	explicit GteTraceScope(int op)
+		: command_(GTE_FUNCT(gteop(op))), sf_(GTE_SF(gteop(op))), lm_(GTE_LM(gteop(op))),
+		  active_(PsyX_TraceGteEnabled() != 0), inputHash_(active_ ? hashGteRegisters() : 0)
+	{
+	}
+
+	~GteTraceScope()
+	{
+		if (!active_)
+			return;
+		const PsyXTraceField fields[] = {
+			{"command", command_}, {"sf", sf_}, {"lm", lm_}, {"input_hash", inputHash_},
+			{"output_hash", hashGteRegisters()}, {"flag", C2_FLAG},
+			{"ir0", C2_IR0}, {"ir1", C2_IR1}, {"ir2", C2_IR2}, {"ir3", C2_IR3},
+			{"sxy0", C2_SXY0}, {"sxy1", C2_SXY1}, {"sxy2", C2_SXY2},
+			{"sz0", C2_SZ0}, {"sz1", C2_SZ1}, {"sz2", C2_SZ2}, {"sz3", C2_SZ3},
+			{"mac0", C2_MAC0}, {"mac1", C2_MAC1}, {"mac2", C2_MAC2}, {"mac3", C2_MAC3},
+			{"rgb2", C2_RGB2}, {"otz", C2_OTZ}
+		};
+		PSYX_TRACE_FIELDS("gte.command", fields);
+	}
+
+private:
+	int command_;
+	int sf_;
+	int lm_;
+	bool active_;
+	uint32_t inputHash_;
+};
+
+} // namespace
+
