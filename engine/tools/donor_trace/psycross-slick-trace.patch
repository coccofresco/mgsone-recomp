+#ifndef PSYX_TRACE_H
+#define PSYX_TRACE_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct PsyXTraceField
+{
+	const char* name;
+	int64_t value;
+} PsyXTraceField;
+
+int PsyX_TraceEnabled(void);
+int PsyX_TraceGteEnabled(void);
+void PsyX_TraceSetFrame(int64_t frame);
+void PsyX_TraceEvent(const char* event, const PsyXTraceField* fields, size_t fieldCount);
+
+#define PSYX_TRACE_FIELDS(eventName, fields) \
+	PsyX_TraceEvent((eventName), (fields), sizeof(fields) / sizeof((fields)[0]))
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
diff --git a/src/PsyX_trace.cpp b/src/PsyX_trace.cpp
new file mode 100644
index 0000000..d89e103
--- /dev/null
+++ b/src/PsyX_trace.cpp
@@ -0,0 +1,108 @@
+#include "PsyX_trace.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+
+namespace {
+
+std::atomic<int64_t> g_traceFrame{0};
+std::atomic<uint64_t> g_traceSequence{0};
+std::mutex g_traceMutex;
+FILE* g_traceOutput = nullptr;
+bool g_traceOpenAttempted = false;
+
+FILE* traceOutputUnlocked()
+{
+	if (g_traceOpenAttempted)
+		return g_traceOutput;
+
+	g_traceOpenAttempted = true;
+	const char* path = std::getenv("PS1_TRACE_JSONL");
+	if (path != nullptr && path[0] != '\0')
+		g_traceOutput = std::fopen(path, "a");
+	return g_traceOutput;
+}
+
+void writeJsonString(FILE* output, const char* value)
+{
+	std::fputc('"', output);
+	for (const unsigned char* p = reinterpret_cast<const unsigned char*>(value); *p; ++p)
+	{
+		switch (*p)
+		{
+		case '"': std::fputs("\\\"", output); break;
+		case '\\': std::fputs("\\\\", output); break;
+		case '\n': std::fputs("\\n", output); break;
+		case '\r': std::fputs("\\r", output); break;
+		case '\t': std::fputs("\\t", output); break;
+		default:
+			if (*p < 0x20)
+				std::fprintf(output, "\\u%04x", static_cast<unsigned>(*p));
+			else
+				std::fputc(*p, output);
+			break;
+		}
+	}
+	std::fputc('"', output);
+}
+
+int envEnabled(const char* name)
+{
+	const char* value = std::getenv(name);
+	return value != nullptr && value[0] != '\0' && std::strcmp(value, "0") != 0;
+}
+
+} // namespace
+
+extern "C" int PsyX_TraceEnabled(void)
+{
+	const char* path = std::getenv("PS1_TRACE_JSONL");
+	return path != nullptr && path[0] != '\0';
+}
+
+extern "C" int PsyX_TraceGteEnabled(void)
+{
+	return PsyX_TraceEnabled() && envEnabled("PS1_TRACE_GTE");
+}
+
+extern "C" void PsyX_TraceSetFrame(int64_t frame)
+{
+	g_traceFrame.store(frame, std::memory_order_release);
+}
+
+extern "C" void PsyX_TraceEvent(const char* event, const PsyXTraceField* fields, size_t fieldCount)
+{
+	if (!PsyX_TraceEnabled())
+		return;
+
+	std::lock_guard<std::mutex> lock(g_traceMutex);
+	FILE* output = traceOutputUnlocked();
+	if (output == nullptr)
+		return;
+
+	const auto now = std::chrono::steady_clock::now().time_since_epoch();
+	const int64_t hostUs = std::chrono::duration_cast<std::chrono::microseconds>(now).count();
+	const char* source = std::getenv("PS1_TRACE_SOURCE");
+	if (source == nullptr || source[0] == '\0')
+		source = "psycross-slick";
+
+	std::fputs("{\"schema\":\"ps1trace/v1\",\"source\":", output);
+	writeJsonString(output, source);
+	std::fprintf(output, ",\"seq\":%llu,\"frame\":%lld,\"host_us\":%lld,\"event\":",
+		static_cast<unsigned long long>(g_traceSequence.fetch_add(1, std::memory_order_relaxed)),
+		static_cast<long long>(g_traceFrame.load(std::memory_order_acquire)),
+		static_cast<long long>(hostUs));
+	writeJsonString(output, event);
+	for (size_t i = 0; i < fieldCount; ++i)
+	{
+		std::fputc(',', output);
+		writeJsonString(output, fields[i].name);
+		std::fprintf(output, ":%lld", static_cast<long long>(fields[i].value));
+	}
+	std::fputs("}\n", output);
+	std::fflush(output);
+}
