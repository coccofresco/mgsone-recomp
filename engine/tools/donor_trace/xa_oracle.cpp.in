// Standalone read-only XA oracle; generated by scripts/mgs_xa_audit.py.
#include "common/cd_xa.h"
#include "runtime/cdrom/xa_adpcm.h"
#include <algorithm>
#include <array>
#include <fstream>
#include <iostream>
#include <vector>
#include <string>
struct Reference {
  std::array<std::array<int16_t,32>,2> m_xa_resample_ring_buffer{};
  uint8_t m_xa_resample_p=0, m_xa_resample_sixstep=6;
  std::vector<int16_t> output;
  void AddCDAudioFrame(int16_t l,int16_t r) {output.push_back(l);output.push_back(r);}
  template<bool STEREO,bool SAMPLE_RATE> void ResampleXAADPCM(const int16_t*,uint32_t);
};
// @DONOR_RESAMPLER@
uint64_t hash(const std::vector<int16_t>& pcm, uint64_t h=14695981039346656037ull) {
  for (auto v:pcm) for (int shift:{0,8}) {h^=(uint16_t(v)>>shift)&255;h*=1099511628211ull;} return h;
}
int main(int argc,char**argv) {
  Reference reference;
  int32_t history[4]{};
  ps1::cdrom::XaAdpcm native;
  std::array<uint8_t,2352> raw{};
  std::array<int16_t,4032> decoded{};
  unsigned sectors=0,restores=0; uint64_t frames=0,h=14695981039346656037ull;
  std::ifstream disc;
  if(argc>1) {disc.open(argv[1],std::ios::binary); disc.seekg(std::stoull(argv[2])*2352);}
  for (unsigned i=0; i<(argc>1?std::stoul(argv[3]):5u);++i) {
    if(argc>1) {disc.read(reinterpret_cast<char*>(raw.data()),raw.size()); if(!disc) return 3;
      if(raw[15]!=2 || (raw[18]&0x44)!=0x44) continue;
    } else {
      raw[19]=1;
      for(unsigned g=0;g<18;g++) {
        auto*p=raw.data()+24+g*128;
        for(unsigned j=4;j<12;j++) p[j]=0x14;
        for(unsigned j=16;j<128;j++) p[j]=uint8_t(j*17+g*29);
      }
    }
    if(raw[19]!=1) return 4;
    CDXA::DecodeADPCMSector(raw.data(),decoded.data(),history);
    reference.output.clear(); reference.ResampleXAADPCM<true,false>(decoded.data(),2016);
    // Every sector boundary, including initial/terminal interpolation phases.
    // A separate instance must reproduce both PCM and the subsequent history.
    ps1::cdrom::XaAdpcm resumed;
    resumed.restore(native.snapshot());
    const auto actual=native.decode(raw.data());
    if(resumed.decode(raw.data())!=actual) {std::cerr<<"restore mismatch sector "<<i<<"\n"; return 2;}
    native.restore(resumed.snapshot());
    restores++;
    if(actual!=reference.output) {std::cerr<<"mismatch sector "<<i<<"\n"; return 1;}
    h=hash(reference.output,h); frames+=actual.size()/2;sectors++;
  }
  std::cout<<"{\"sectors\":"<<sectors<<",\"stereo_frames\":"<<frames<<",\"restore_boundaries\":"<<restores<<",\"fnv1a64\":\""<<std::hex<<h<<"\",\"sample_exact\":true}\n";
}
