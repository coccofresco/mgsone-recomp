vec2 mgs_bubble_local(vec2 q,int cluster) {
  vec2 point=q*2.0-1.0;
  float nearest=1e10;
  if(cluster==1) for(int i=0;i<6;++i) {
    vec4 shape=mgs_bubble_cluster_1[i];
    vec2 candidate=(q-shape.xy)/shape.zw*0.88;
    float distance=dot(candidate,candidate);
    if(distance<nearest) {nearest=distance;point=candidate;}
  }
  if(cluster==2) for(int i=0;i<12;++i) {
    vec4 shape=mgs_bubble_cluster_2[i];
    vec2 candidate=(q-shape.xy)/shape.zw*0.88;
    float distance=dot(candidate,candidate);
    if(distance<nearest) {nearest=distance;point=candidate;}
  }
  if(cluster==3) for(int i=0;i<25;++i) {
    vec4 shape=mgs_bubble_cluster_3[i];
    vec2 candidate=(q-shape.xy)/shape.zw*0.88;
    float distance=dot(candidate,candidate);
    if(distance<nearest) {nearest=distance;point=candidate;}
  }
  return point;
}
