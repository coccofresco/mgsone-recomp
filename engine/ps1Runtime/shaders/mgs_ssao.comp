#version 450
#extension GL_GOOGLE_include_directive : require
// Adapted from Godot 4.7.2 / Intel ASSAO. Full copyright and MIT terms:
// engine/third_party/godot_ssao/{LICENSE.txt,ASSAO-LICENSE.txt}.
// This adapter uses a single half-resolution plane, geometric normals from
// current depth and 12 mirrored disk taps; no temporal history or depth mips.
// Distance-dependent radius unprojection adapted from N8AO (CC0-1.0):
// engine/third_party/n8ao_radius/{provenance.json,LICENSE}.
layout(local_size_x=8, local_size_y=8) in;
layout(set=0,binding=0) uniform sampler2D u_ao_depth;
layout(rgba8,set=0,binding=2) uniform writeonly image2D u_ao_output;
#include "mgs_ssao_common.glsl"

const vec3 pattern[12] = vec3[](
  vec3(0.78488064,0.56661671,1.50), vec3(0.26022232,-0.29575172,1.50),
  vec3(0.10459357,0.08372527,1.11), vec3(-0.68286800,0.04963045,1.09),
  vec3(-0.13570161,-0.64190155,1.25), vec3(-0.26193795,-0.08205118,0.67),
  vec3(-0.61177456,0.66664219,0.71), vec3(0.43675563,0.25119025,0.61),
  vec3(0.07884444,0.86618668,0.64), vec3(-0.12790935,-0.29869005,0.60),
  vec3(-0.04031125,0.02413622,0.60), vec3(0.16201244,-0.52851415,0.79));

float obscurance(vec3 normal, vec3 delta, float falloff) {
  float length_sq = max(dot(delta,delta), 1e-8);
  float nd = dot(normal,delta) * inversesqrt(length_sq);
  return max(0.0, nd - 0.06) * max(0.0, length_sq * falloff + 1.0);
}
float world_radius(float view_depth, float view_distance) {
  // N8AO's screenSpaceRadius measures the distance between two unprojected
  // positions at the same depth. For our perspective camera, a vertical
  // screen span unprojects to span * Z / focalY, without extra depth fetches.
  // Use a fraction of view height (not physical pixels) for resolution and
  // aspect independence. The floor, cap and near-camera policy are ours.
  const float screen_fraction = 0.16;
  const float maximum_growth = 3.0;
  float native_height = float(ao.extentFormat.y) * float(ao.source.z);
  float screen_radius = screen_fraction * native_height * view_depth / ao.camera.y;
  float radius = clamp(screen_radius, ao.tuning.x, maximum_growth * ao.tuning.x);
  return radius * (clamp(view_distance/(ao.tuning.x*1.2),0.0,1.0)*0.8+0.2);
}
void main() {
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
  if (any(greaterThanEqual(pixel, ao_size()))) return;
  ivec2 p = ao_center(pixel);
  float z = ao_depth(p);
  if (z == 0.0) { imageStore(u_ao_output,pixel,vec4(1,0,0,0)); return; }
  vec3 center = ao_position(p,z);
  const ivec2 offsets[4] = ivec2[](ivec2(-2,0),ivec2(2,0),ivec2(0,-2),ivec2(0,2));
  vec4 neighbor;
  vec3 delta[4];
  for (int i=0;i<4;++i) {
    neighbor[i] = ao_depth(p+offsets[i]);
    delta[i] = ao_position(p+offsets[i], neighbor[i]) - center;
  }
  // Pick the side on the same surface, avoiding silhouette normals bridging
  // foreground and background. Invalid neighbors never become occluders.
  vec3 dx = neighbor.x > 0.0 && (neighbor.y == 0.0 || abs(neighbor.x-z) < abs(neighbor.y-z)) ? -delta[0] : delta[1];
  vec3 dy = neighbor.z > 0.0 && (neighbor.w == 0.0 || abs(neighbor.z-z) < abs(neighbor.w-z)) ? -delta[2] : delta[3];
  vec3 n = cross(dy,dx);
  float length2 = dot(n,n);
  if (length2 < 1e-12 || (neighbor.x == 0.0 && neighbor.y == 0.0) || (neighbor.z == 0.0 && neighbor.w == 0.0)) {
    imageStore(u_ao_output,pixel,vec4(1,0,0,0)); return;
  }
  n *= inversesqrt(length2);
  if (dot(n,center) > 0.0) n = -n;
  // Godot/ASSAO slope-sensitive edges, near-camera radius clamp, halo
  // suppression and weighted symmetric taps. Units here are MGS world units.
  vec4 differences = neighbor - z;
  vec4 edges = clamp(1.3 - min(abs(differences),abs(differences+differences.yxwz)) / (z*0.04),0.0,1.0);
  edges *= step(vec4(0.0001),neighbor);
  // Sampling and world-distance falloff must use the SAME expanded radius.
  float radius = world_radius(z, length(center));
  float lookup = 0.85 * radius * ao.camera.x * float(ao.source.w) / (2.0*z);
  vec2 uv = (vec2(pixel)+0.5)/vec2(ao_size());
  float border = min(min(uv.x,1.0-uv.x),min(uv.y,1.0-uv.y));
  lookup *= clamp(border*10.0+0.6,0.0,1.0);
  float angle = float((pixel.x+2*pixel.y)%5) * 1.0471975512;
  mat2 rotation = mat2(cos(angle),-sin(angle),sin(angle),cos(angle));
  float sum = 0.0, weight_sum = 0.0;
  for (int i=0;i<12;++i) {
    ivec2 offset = ivec2(round(rotation * pattern[i].xy * lookup * vec2(1.0,ao.camera.y/ao.camera.x)));
    for (int side=-1;side<=1;side+=2) {
      ivec2 sample_pixel = p + offset*2*side;
      float sample_z = ao_depth(sample_pixel);
      if (sample_z == 0.0) continue;
      vec3 hit = ao_position(sample_pixel,sample_z) - center;
      float reduce = clamp(max(0.0,-hit.z)*(-1.0/radius)+2.0,0.0,1.0);
      float weight = (0.6*reduce+0.4)*pattern[i].z;
      sum += obscurance(n,hit,-1.0/(radius*radius))*weight;
      weight_sum += weight;
    }
  }
  float edge_fade = clamp((1.0-edges.x-edges.y)*0.35,0.0,1.0)+clamp((1.0-edges.z-edges.w)*0.35,0.0,1.0);
  float obscured = min(ao.tuning.y*sum/max(weight_sum,0.0001),ao.tuning.w) * clamp(1.0-edge_fade,0.0,1.0);
  float visibility = pow(clamp(1.0-obscured,0.0,1.0),ao.tuning.z);
  imageStore(u_ao_output,pixel,vec4(visibility,ao_pack_edges(edges),0,0));
}
